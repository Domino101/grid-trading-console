# Install after replacing /opt/crypto-trading-open and crypto with the real paths/user.
# sudo install -m 0644 scripts/deployment/crypto-webui.service /etc/systemd/system/crypto-webui.service
[Unit]
Description=Crypto Trading Web UI API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crypto
Group=crypto
WorkingDirectory=/opt/crypto-trading-open/web_ui/backend
EnvironmentFile=-/opt/crypto-trading-open/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/crypto-trading-open
ExecStart=/opt/crypto-trading-open/venv/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8001 --proxy-headers
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/crypto-trading-open/config /opt/crypto-trading-open/data /opt/crypto-trading-open/logs

[Install]
WantedBy=multi-user.target
