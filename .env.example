# ============================================================================
# 量化網格交易系統 - 環境變數設定範本 (.env.example)
# ============================================================================
# 使用方式：
# 1. 複製此檔案為 .env：cp .env.example .env
# 2. 填入您的真實交易所 API 金鑰與設定
# ⚠️ 注意：切勿將包含真實金鑰的 .env 檔案提交至 Git 版本控制。
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
# 1. 系統安全性與交易模式總開關 (System & Safety Switches)
# ────────────────────────────────────────────────────────────────────────────
# 實盤總開關：1 或 true 開啟實盤；0 或 false 僅允許 PAPER 模擬回測撮合
GRID_LIVE_TRADING_ENABLED=1

# Web UI 與 REST API 存取安全權杖 (Bearer Token)
# 可由系統自動生成 64 位元 Hex，或自訂高強度 Token
GRID_API_TOKEN=<REDACTED_GRID_API_TOKEN>

# CORS 跨域存取白名單 (多個來源以逗號分隔，預設允許本機與區網)
# 例如: http://127.0.0.1:8001,http://192.168.8.101:8001
GRID_CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001,http://127.0.0.1:5173,http://localhost:5173

# ────────────────────────────────────────────────────────────────────────────
# 2. 交易所 API 金鑰配置 (Exchange API Keys)
# ────────────────────────────────────────────────────────────────────────────

# [Binance 幣安]
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# [Lighter DEX]
# Lighter 通常使用以太坊私鑰 (Private Key) 或專用 API Key
LIGHTER_API_KEY=your_lighter_private_key_here
LIGHTER_API_SECRET=your_lighter_secret_here

# [Hyperliquid DEX]
# Hyperliquid 使用私鑰與錢包地址認證
HYPERLIQUID_API_KEY=your_hyperliquid_private_key_here
HYPERLIQUID_API_SECRET=your_hyperliquid_secret_here
HYPERLIQUID_WALLET_ADDRESS=your_hyperliquid_wallet_address_here

# [Backpack 交易所]
BACKPACK_API_KEY=your_backpack_api_key_here
BACKPACK_API_SECRET=your_backpack_api_secret_here

# [OKX 歐易]
OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here

# [EdgeX]
EDGEX_API_KEY=your_edgex_api_key_here
EDGEX_API_SECRET=your_edgex_api_secret_here

# [O1Exchange]
O1EXCHANGE_API_KEY=your_o1exchange_api_key_here
O1EXCHANGE_API_SECRET=your_o1exchange_api_secret_here

# ────────────────────────────────────────────────────────────────────────────
# 3. 通知與監控 (Notifications & Alerts - 可選)
# ────────────────────────────────────────────────────────────────────────────
# Telegram Bot 通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
